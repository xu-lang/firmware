 }
+
+#define TX_PATH_REG       0x80c
+#define TX_PATH_LOW_A     0x1111
+#define TX_PATH_LOW_B     0x2222
+#define TX_PATH_LOW_AB    0x3333
+#define RX_PATH_REG       0x808
+#define RX_PATH_LOW_A     0x11
+#define RX_PATH_LOW_B     0x22
+#define RX_PATH_LOW_AB    0x33
+#define CCK_RX_REG        0xa04
+
+static int proc_get_tx_path(struct seq_file *m, void *v)
+{
+	struct net_device *dev = m->private;
+	_adapter *adapter = (_adapter *)rtw_netdev_priv(dev);
+	u16 tx_low = rtw_read32(adapter, TX_PATH_REG) & 0xffff;
+	u8 rx_low = rtw_read32(adapter, RX_PATH_REG) & 0xff;
+	u32 cck = rtw_read32(adapter, CCK_RX_REG);
+
+	RTW_PRINT_SEL(m, "tx=0x%04x rx=0x%02x cck=0x%08x", tx_low, rx_low, cck);
+	if (tx_low == TX_PATH_LOW_A && rx_low == RX_PATH_LOW_A)
+		RTW_PRINT_SEL(m, " (a)");
+	else if (tx_low == TX_PATH_LOW_B && rx_low == RX_PATH_LOW_B)
+		RTW_PRINT_SEL(m, " (b)");
+	else if (tx_low == TX_PATH_LOW_AB && rx_low == RX_PATH_LOW_AB)
+		RTW_PRINT_SEL(m, " (ab)");
+	RTW_PRINT_SEL(m, "\n");
+
+	return 0;
+}
+
+static ssize_t proc_set_tx_path(struct file *file, const char __user *buffer, size_t count, loff_t *pos, void *data)
+{
+	struct net_device *dev = data;
+	_adapter *adapter = (_adapter *)rtw_netdev_priv(dev);
+	char input[32], *p, *rx_p, *cck_p;
+	u32 val, cck;
+	u16 low;
+	u8 rx_low;
+
+	if (count >= sizeof(input))
+		return -EINVAL;
+	if (copy_from_user(input, buffer, count))
+		return -EFAULT;
+	input[count] = '\0';
+	p = strim(input);
+	rx_p = strpbrk(p, " \t");
+	if (rx_p) {
+		*rx_p++ = '\0';
+		rx_p = strim(rx_p);
+		cck_p = strpbrk(rx_p, " \t");
+		if (cck_p) {
+			*cck_p++ = '\0';
+			cck_p = strim(cck_p);
+		}
+	} else
+		cck_p = NULL;
+
+	val = rtw_read32(adapter, TX_PATH_REG);
+	low = val & 0xffff;
+	rx_low = rtw_read32(adapter, RX_PATH_REG) & 0xff;
+	cck = rtw_read32(adapter, CCK_RX_REG);
+
+	if (strncmp(p, "b", 1) == 0 || strncmp(p, "B", 1) == 0) {
+		low = TX_PATH_LOW_B;
+		rx_low = RX_PATH_LOW_B;
+		cck = 1;
+	} else if (strncasecmp(p, "ab", 2) == 0) {
+		low = TX_PATH_LOW_AB;
+		rx_low = RX_PATH_LOW_AB;
+		cck = 0;
+	} else if (strncmp(p, "a", 1) == 0 || strncmp(p, "A", 1) == 0) {
+		low = TX_PATH_LOW_A;
+		rx_low = RX_PATH_LOW_A;
+		cck = 0;
+	} else if (kstrtou16(p, 16, &low) != 0)
+		return -EINVAL;
+
+	if (rx_p && kstrtou8(rx_p, 16, &rx_low) != 0)
+		return -EINVAL;
+	if (cck_p && kstrtou32(cck_p, 16, &cck) != 0)
+		return -EINVAL;
+
+	val = rtw_read32(adapter, TX_PATH_REG);
+	val = (val & 0xffff0000) | low;
+	rtw_write32(adapter, TX_PATH_REG, val);
+
+	val = rtw_read32(adapter, RX_PATH_REG);
+	val = (val & 0xffffff00) | rx_low;
+	rtw_write32(adapter, RX_PATH_REG, val);
+
+	if (cck_p || strncasecmp(p, "a", 1) == 0 || strncasecmp(p, "b", 1) == 0 || strncasecmp(p, "ab", 2) == 0)
+		rtw_write32(adapter, CCK_RX_REG, cck);
+
+	RTW_INFO("proc_set_tx_path: tx=0x%04x rx=0x%02x cck=0x%08x\n", low, rx_low, cck);
+
+	return count;
+}
